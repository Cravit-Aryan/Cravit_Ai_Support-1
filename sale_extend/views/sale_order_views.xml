<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sale_extend" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.extend</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="xyz"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_inherit_sale_extend" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.sale.extend</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="xyz" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
